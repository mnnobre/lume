{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume",
  "version": "../package.json",
  "identifier": "com.mnnobre.lume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lume",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOUZCOEM4RDNEMUFCQzMKUldURHE5SFR5TGlmL0R2aHN1dGpzVVZGM3BmaW5ZT0kvZEFBNi9vL1BsWVoyU2ZxcWFlWmlNbEkK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
